# TrendRadar Agent Service 环境变量配置
# 复制此文件为 .env 并填入你的配置

# ============================================
# OpenAI API 配置
# ============================================

# OpenAI API Key（必需）
OPENAI_API_KEY=

# API Base URL（可选，用于兼容其他 OpenAI 接口）
# 示例：
#   - OpenAI: https://api.openai.com/v1
#   - Azure: https://your-resource.openai.azure.com
#   - 其他兼容服务: https://your-api-endpoint/v1
# OPENAI_BASE_URL=

# ============================================
# Supabase 配置
# ============================================

# Supabase 项目 URL
# 获取方式：Supabase 控制台 -> Settings -> API -> Project URL
SUPABASE_URL=

# Supabase API Key (anon public key)
# 获取方式：Supabase 控制台 -> Settings -> API -> anon public
SUPABASE_ANON_KEY=

# ============================================
# Agent 配置
# ============================================

# Agent 使用的 LLM 模型
# 推荐：gpt-4o, gpt-4-turbo, gpt-3.5-turbo
AGENT_MODEL=gpt-4o

# Embedding 模型
# 推荐：text-embedding-3-small (1536维), text-embedding-3-large (3072维)
EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# 服务配置
# ============================================

# 服务端口
PORT=3001

# 运行环境
NODE_ENV=development
