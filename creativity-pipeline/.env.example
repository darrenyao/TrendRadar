# Creativity Pipeline Environment Variables

# ==================== AI Agents ====================
# No API key needed - Claude Agent SDK uses Claude Code CLI local auth
# Prerequisites:
#   1. npm install -g @anthropic-ai/claude-code
#   2. claude login
#   3. pip install claude-agent-sdk

# ==================== DingTalk ====================

DINGTALK_CLIENT_ID=your_client_id
DINGTALK_CLIENT_SECRET=your_client_secret

# 单聊模式：接收人工号（推荐）
DINGTALK_USER_ID=107578

# 群聊模式：会话 ID（可选，与 USER_ID 二选一）
# DINGTALK_CONVERSATION_ID=cidxxxxx

# ==================== Data Sources ====================

# TikHub API Key (for Twitter/Reddit/小红书)
# Get your key from: https://api.tikhub.io/
# Leave empty to use NewsNow only (国内平台)
TIKHUB_API_KEY=

# ==================== Optional ====================

# Obsidian Vault Path
VAULT_PATH=./vault

# Schedule Times (HH:MM format)
MORNING_PUSH_TIME=09:00
AFTERNOON_PUSH_TIME=14:00
EVENING_PUSH_TIME=21:30

# Timezone
TZ=Asia/Shanghai
